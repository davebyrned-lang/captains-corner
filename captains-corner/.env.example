# ---- REQUIRED ----
# Get this from https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ---- OPTIONAL (sensible defaults already set in code) ----
# claude-sonnet-5 is the cost/quality sweet spot. claude-opus-5 is smarter but ~5x the price.
ANTHROPIC_MODEL=claude-sonnet-5

# How many free reviews per person per day before they are asked to upgrade.
FREE_REVIEWS_PER_DAY=2

# Turn the paywall on only when you are ready to charge (phase 2). Leave false for launch.
PAYWALL_ENABLED=false

# ---- PHASE 2: persistent rate limiting (optional) ----
# Without these, limits reset whenever the server restarts. Fine for launch.
# Free tier at https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- PHASE 2: Stripe (optional) ----
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# ---- WEB RESEARCH FALLBACK ----
# When FPL has little data (pre-season, or no squad loaded), the app searches
# public football sources first. Costs $10 per 1,000 searches on top of tokens,
# so roughly 4 cents extra per review at the default cap.
ENABLE_WEB_RESEARCH=true
RESEARCH_MAX_SEARCHES=4
# Run research on a fast model so the whole request still fits in 60 seconds.
ANTHROPIC_RESEARCH_MODEL=claude-haiku-4-5-20251001
# Comma separated. Leave unset for a sensible default list of football sources.
RESEARCH_DOMAINS=

# ---- CHAT COST LEVERS ----
# Chat can run on a cheaper model than the review without much quality loss.
# Setting this to claude-haiku-4-5-20251001 cuts chat cost by roughly two thirds.
ANTHROPIC_CHAT_MODEL=
# How many past exchanges to resend each turn. Lower is cheaper. 8 is comfortable.
CHAT_HISTORY_TURNS=8
# Cap on reply length. 900 keeps answers tight and costs down.
CHAT_MAX_TOKENS=900
